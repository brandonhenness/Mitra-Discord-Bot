# Copy to .env for local development.
# Required
DISCORD_APPLICATION_TOKEN=your_discord_bot_token_here

# Optional
MITRA_ENABLE_MEMBERS_INTENT=true
# Scoped Cloudflare Bearer API token with DNS read/edit access; not a Global API Key.
CLOUDFLARE_API_TOKEN=
MITRA_CONFIG_PATH=config.toml
MITRA_STATE_PATH=state.db
